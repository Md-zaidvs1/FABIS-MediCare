# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Supabase Cloud Database & Storage Credentials
VITE_SUPABASE_URL=https://xusaegwehwukwlqsqjsh.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Default Administrator Credentials
DEFAULT_ADMIN_EMAIL=admin
DEFAULT_ADMIN_PASSWORD=admin@123

# Default Doctor Credentials
DEFAULT_DOCTOR_EMAIL=doctor@hospital.com
DEFAULT_DOCTOR_PASSWORD=Doctor@123

# TextBee SMS Gateway Credentials
TEXTBEE_API_KEY=
TEXTBEE_DEVICE_ID=

